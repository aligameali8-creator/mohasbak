<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:padding="14dp"
    android:background="@drawable/mohasbak_widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#C9CCFF" android:textSize="12sp" android:gravity="start" android:maxLines="1" />
        <TextView android:id="@+id/w_big" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:gravity="start" android:maxLines="1" />
        <TextView android:id="@+id/w_line1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#E8EAFF" android:textSize="12sp" android:gravity="start" android:maxLines="1" />
        <TextView android:id="@+id/w_line2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#C9CCFF" android:textSize="11sp" android:gravity="start" android:maxLines="1" />
    </LinearLayout>

    <TextView android:id="@+id/w_add"
        android:layout_width="52dp" android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/mohasbak_widget_btn"
        android:gravity="center" android:text="+" android:textColor="#3B43A6" android:textSize="30sp" android:textStyle="bold"
        android:contentDescription="سجّل مصروف" />
</LinearLayout>
